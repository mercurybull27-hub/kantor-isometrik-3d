# Salin file ini menjadi `.env`, lalu isi kuncinya.
# .env tidak pernah di-commit dan tidak pernah dikirim ke browser.

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Opsional — ubah model bila akun Anda memakai nama lain
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Opsional — bila memakai proxy/gateway kompatibel OpenAI
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

PORT=8000
